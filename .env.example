# Copia este archivo como .env. Partidos, game logs, lesiones, plantillas y estadísticas salen de ESPN (gratis, sin clave).
# La clave de https://the-odds-api.com (plan gratis: 500 créditos/mes) solo hace falta para cuotas reales de varias casas
# y props de jugador. Sin clave la app usa demo-odds.json y demo-props.json y lo indica en la interfaz.
COFLAS_ODDS_API_KEY=

# Líneas de partido (/api/odds): regiones us, us2, uk, eu, au. Coste = 3 mercados (ganador, hándicap, totales) x regiones
# por consulta; con eu,us son 6 créditos cada 5 min de caché por deporte.
COFLAS_REGIONS=eu,us

# Props de jugador (/api/props). /v4/sports/{deporte}/events es gratis; /events/{id}/odds cuesta
# [mercados devueltos] x [regiones] POR PARTIDO. Los mercados salen de public/stats.js (NBA hasta 17, NFL hasta 18,
# MLB 17, NHL 6, fútbol 5), así que un partido de la NBA con us,us2,eu puede costar ~50 créditos.
# Las props casi solo las ofrecen casas de EE. UU. (us, us2); quitar eu abarata un tercio.
COFLAS_PROP_REGIONS=us
# Partidos (los más próximos) que se consultan cuando /api/props no recibe ?game=. Con ?game= solo se consulta ese partido.
COFLAS_PROPS_MAX_EVENTS=4
